msgstr "Buscarlas e instalarlas solas"

#: apps/reiwand-app/qml/SettingsMore.qml
msgid ""
"New wallpapers and new versions of the ones you have, in the repositories "
"you added."
msgstr ""
"Fondos nuevos y versiones nuevas de los que tienes, en los repositorios que "
"añadiste."

#: apps/reiwand-app/qml/SettingsMore.qml
#: apps/reiwand-app/qml/SettingsWallpapers.qml
