msgid "added %1: %2"
msgstr "agregado %1: %2"

#: apps/reiwand-ctl/src/carrying_show.rs
msgid "%1 entries refer to wallpapers that are not here and were left out"
msgstr "%1 entradas se refieren a fondos que no están aquí y se dejaron fuera"

#: apps/reiwand-ctl/src/carrying_show.rs
msgid "pending, %1 %2: %3"
msgstr "pendiente, %1 %2: %3"

#: apps/reiwand-ctl/src/caution.rs
msgid ""
"To allow wallpapers that flash, run: reiwand-ctl config playback."
"allow_flashing true"
msgstr ""
"Para permitir los fondos que destellan, ejecuta: reiwand-ctl config playback."
"allow_flashing true"

#: apps/reiwand-ctl/src/caution.rs
msgid "Installed %1 %2."
msgstr "Se instaló %1 %2."

#: apps/reiwand-ctl/src/cli.rs
msgid "Control the Reiwand daemon"
msgstr "Controlar el daemon de Reiwand"

#: apps/reiwand-ctl/src/cli.rs
msgid "Set the wallpaper: an image or a video"
msgstr "Fijar el fondo: una imagen o un vídeo"

#: apps/reiwand-ctl/src/cli.rs
msgid "Local image or video file, as a path or a file:// URI"
msgstr "Imagen o vídeo local, como ruta o URI file://"

#: apps/reiwand-ctl/src/cli.rs
msgid ""
"Remove the wallpaper and give the screen back to the desktop; restore brings "
"it back"
msgstr ""
"Quita el fondo y devuelve la pantalla al escritorio; restore lo recupera"

