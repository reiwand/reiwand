msgid "Repeat the password: "
msgstr "Repite la contraseña: "

#: apps/reiwand-ctl/src/carrying.rs apps/reiwand-ctl/src/input.rs
msgid "the passwords differ"
msgstr "las contraseñas no coinciden"

#: apps/reiwand-ctl/src/carrying.rs
msgid "the password is empty"
msgstr "la contraseña está vacía"

#: apps/reiwand-ctl/src/carrying_show.rs
