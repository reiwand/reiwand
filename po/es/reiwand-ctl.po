msgstr "%1: las luces esperan porque %2"

#: apps/reiwand-ctl/src/rgb.rs
msgid "colors from %1, %2 frames sent"
msgstr "colores de %1, %2 fotogramas enviados"

#: apps/reiwand-ctl/src/rgb.rs
msgid ", own mode %1 comes back when the lights stop"
msgstr ", su propio modo %1 vuelve cuando las luces se detienen"

#: apps/reiwand-ctl/src/rgb.rs
msgid ", own mode %1"
msgstr ", su propio modo %1"

#: apps/reiwand-ctl/src/rgb.rs
msgid "no devices"
msgstr "sin dispositivos"

#: apps/reiwand-ctl/src/rgb.rs
msgid "every device takes the whole picture"
msgstr "cada dispositivo toma la imagen completa"

#: apps/reiwand-ctl/src/rgb.rs
