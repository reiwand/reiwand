# Public URL of the server, as clients write it (required)
REIWAND_PUBLIC_URL=https://wallpapers.example.org
# Version of the image (latest when left out)
REIWAND_VERSION=latest
# Address and port of the machine the container listens on
REIWAND_BIND=127.0.0.1:8080
# Name of the instance
REIWAND_NAME=reiwand
# New accounts: closed, invite or open (starting value; what you choose in /setup wins)
REIWAND_REGISTRATION=invite
# Publish uploads without review: never, trusted or all (starting value; what you choose in /setup wins)
REIWAND_AUTO_PUBLISH=trusted
# SPDX licenses accepted in uploads, separated by commas
REIWAND_LICENSES=CC0-1.0,CC-BY-4.0,CC-BY-SA-4.0
# Largest package in MiB (mind client_max_body_size of the proxy)
REIWAND_PACKAGE_MAX_MIB=256
# Package storage per account, in MiB
REIWAND_USER_QUOTA_MIB=2048
# Uploads per account and day
REIWAND_UPLOADS_PER_DAY=20
# Sync records per account, in MiB
REIWAND_SYNC_QUOTA_MIB=64
# Private files per account, in MiB
REIWAND_FILES_QUOTA_MIB=1024
# Days each signed index lives (1 to 14)
REIWAND_ENTRY_DAYS=7
# Most hours between two signatures of the index
REIWAND_RESIGN_HOURS=24
# Seconds to wait after a moderation decision before signing
REIWAND_PUBLISH_DELAY_SECS=30
# Operator of the service, for the legal pages
REIWAND_LEGAL_OPERATOR=
# Contact of the legal pages
REIWAND_LEGAL_CONTACT=
# Jurisdiction of the legal pages
REIWAND_LEGAL_JURISDICTION=
# DMCA agent of the legal pages
REIWAND_LEGAL_DMCA_AGENT=
# Abuse log with the IP of the clients: off, prefix or full
REIWAND_LOG_CLIENTS=off
# Days that log is kept (1 to 30)
REIWAND_LOG_CLIENTS_DAYS=7
# Days a legal notice keeps the details of its sender (1 to 730)
REIWAND_NOTICE_DAYS=180
# Days a withdrawn package is kept as evidence (1 to 3650)
REIWAND_TAKEDOWN_DAYS=90
# Request limits in memory: true or false
REIWAND_RATE_LIMITS=true
# off, or self-signed to serve HTTPS with its own certificate (starting value; the Network step of /setup wins)
REIWAND_TLS=off
# Announce the server on the local network over mDNS: true or false
REIWAND_ADVERTISE=false
# Log filter (for example info or debug)
REIWAND_LOG=info
