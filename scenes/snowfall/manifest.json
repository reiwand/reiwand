{
  "schema": "reiwand.wpak/2",
  "id": "io.github.reiwand.example.snowfall",
  "version": "1.2.0",
  "title": {
    "en": "Snowfall",
    "es": "Nevada"
  },
  "description": {
    "en": "Snow drifting over pines in moonlight, with particles, drifting clouds, light rays, a vignette, film grain and the sound of the wind.",
    "es": "Nieve que cae sobre pinos a la luz de la luna, con partículas, nubes a la deriva, rayos de luz, viñeta, grano de película y el sonido del viento."
  },
  "changes": {
    "en": "Shows the pictures of a folder you choose behind the snow.",
    "es": "Muestra las imágenes de una carpeta que elijas tras la nieve."
  },
  "default_locale": "en",
  "authors": [
    "Reiwand contributors"
  ],
  "license": "CC0-1.0",
  "credits": [
    {
      "paths": [
        "assets/wind.ogg"
      ],
      "license": "CC0-1.0",
      "attribution": "Reiwand contributors"
    }
  ],
  "origin": {
    "kind": "original"
  },
  "content": {
    "rating": "general"
  },
  "photosensitive": false,
  "kind": "scene",
  "entry": "scene.json",
  "previews": {
    "thumbnail": "preview.jpg"
  },
  "tags": [
    "example",
    "winter",
    "particles",
    "sound"
  ],
  "requires": {
    "features": [
      "effect.film_grain.bias",
      "effect.film_grain.blend",
      "effect.film_grain.mono",
      "effect.god_rays.angle",
      "effect.god_rays.edges",
      "effect.god_rays.mode",
      "effect.god_rays.noise",
      "folder",
      "properties2",
      "sound"
    ]
  },
  "properties": {
    "clouds": {
      "label": {
        "en": "Clouds",
        "es": "Nubes"
      },
      "order": 2,
      "type": "bool",
      "default": true
    },
    "density": {
      "label": {
        "en": "Snowflakes per second",
        "es": "Copos por segundo"
      },
      "type": "slider",
      "min": 10.0,
      "max": 120.0,
      "step": 5.0,
      "default": 80.0,
      "integer": true
    },
    "photos": {
      "label": {
        "en": "Pictures behind the snow",
        "es": "Imágenes tras la nieve"
      },
      "help": {
        "en": "Shows the pictures of a folder you choose behind the falling snow, a new one every ten minutes.",
        "es": "Muestra las imágenes de una carpeta que elijas tras la nieve que cae, una nueva cada diez minutos."
      },
      "order": 4,
      "type": "folder",
      "accept": [
        "image"
      ],
      "pick": "sequence",
      "every": 600
    },
    "volume": {
      "label": {
        "en": "Wind volume",
        "es": "Volumen del viento"
      },
      "order": 3,
      "type": "slider",
      "min": 0.0,
      "max": 100.0,
      "step": 5.0,
      "default": 100.0,
      "integer": true
    },
    "wind": {
      "label": {
        "en": "Wind",
        "es": "Viento"
      },
      "order": 1,
      "type": "combo",
      "options": [
        {
          "value": "calm",
          "label": {
            "en": "Calm",
            "es": "En calma"
          }
        },
        {
          "value": "breeze",
          "label": {
            "en": "Breeze",
            "es": "Brisa"
          }
        },
        {
          "value": "gale",
          "label": {
            "en": "Gale",
            "es": "Ventisca"
          }
        }
      ],
      "default": "breeze"
    }
  },
  "presets": [
    {
      "id": "blizzard",
      "label": {
        "en": "Blizzard",
        "es": "Tormenta de nieve"
      },
      "values": {
        "density": 120,
        "wind": "gale"
      }
    },
    {
      "id": "quiet",
      "label": {
        "en": "Quiet night",
        "es": "Noche tranquila"
      },
      "values": {
        "clouds": false,
        "density": 25,
        "wind": "calm"
      }
    }
  ]
}
