{
  "schema": "reiwand.wpak/2",
  "id": "io.github.reiwand.example.dusk",
  "version": "1.1.0",
  "title": "@title",
  "description": "@description",
  "changes": "@changes",
  "default_locale": "en",
  "strings": {
    "en": {
      "caption": "Text",
      "caption_color": "Text color",
      "caption_help": "Shown in the lower left corner.",
      "changes": "Describes itself in English and Spanish and declares its rating and the inputs it uses.",
      "depth": "Depth",
      "description": "Layered hills under a low sun.\n\n- **Blend modes** and a masked reflection\n- A timeline that brings the light in\n- Depth that follows your finger or the pointer once you allow it\n- Settings for the time of day, the light and a caption",
      "dusk": "Dusk",
      "golden": "Golden hour",
      "light": "Light color",
      "look": "Look",
      "mood": "Time of day",
      "moonlight": "Moonlight",
      "night": "Night",
      "off": "Off",
      "orbit": "Slow orbit",
      "pointer": "Follow the pointer",
      "stars": "Stars",
      "sun_size": "Sun size",
      "title": "Dusk hills",
      "vignette": "Dark corners",
      "warmth": "Light strength",
      "words": "Caption"
    },
    "es": {
      "caption": "Texto",
      "caption_color": "Color del texto",
      "caption_help": "Se muestra en la esquina inferior izquierda.",
      "changes": "Se describe en inglés y en español y declara su clasificación y las entradas que usa.",
      "depth": "Profundidad",
      "description": "Colinas en capas bajo el sol del atardecer.\n\n- **Modos de fusión** y un reflejo con máscara\n- Una línea de tiempo que hace entrar la luz\n- Profundidad que sigue a tu dedo o al puntero cuando lo permites\n- Ajustes para el momento del día, la luz y un rótulo",
      "dusk": "Atardecer",
      "golden": "Hora dorada",
      "light": "Color de la luz",
      "look": "Aspecto",
      "mood": "Momento del día",
      "moonlight": "Luz de luna",
      "night": "Noche",
      "off": "Apagada",
      "orbit": "Órbita lenta",
      "pointer": "Seguir al puntero",
      "stars": "Estrellas",
      "sun_size": "Tamaño del sol",
      "title": "Colinas al atardecer",
      "vignette": "Esquinas oscuras",
      "warmth": "Intensidad de la luz",
      "words": "Rótulo"
    }
  },
  "authors": [
    "Reiwand contributors"
  ],
  "license": "CC0-1.0",
  "origin": {
    "kind": "original"
  },
  "content": {
    "rating": "general"
  },
  "photosensitive": false,
  "kind": "scene",
  "entry": "scene.json",
  "previews": {
    "thumbnail": "preview.jpg"
  },
  "tags": [
    "example",
    "landscape",
    "depth"
  ],
  "requires": {
    "features": [
      "effect.blur_motion.follow",
      "effect.blur_motion.shutter",
      "effect.depth_parallax.scale",
      "effect.depth_parallax.smooth",
      "inputs.pointer"
    ]
  },
  "inputs": [
    "pointer"
  ],
  "properties": {
    "caption": {
      "label": "@caption",
      "help": "@caption_help",
      "group": "words",
      "order": 1,
      "type": "text",
      "default": "",
      "max_len": 40,
      "multiline": false
    },
    "caption_color": {
      "label": "@caption_color",
      "group": "words",
      "order": 2,
      "type": "color",
      "default": "#ffffffd0",
      "alpha": true
    },
    "depth": {
      "label": "@depth",
      "group": "look",
      "order": 7,
      "type": "combo",
      "options": [
        {
          "value": "pointer",
          "label": "@pointer"
        },
        {
          "value": "orbit",
          "label": "@orbit"
        },
        {
          "value": "off",
          "label": "@off"
        }
      ],
      "default": "pointer"
    },
    "light": {
      "label": "@light",
      "group": "look",
      "order": 3,
      "type": "color",
      "default": "#ff9a5c",
      "alpha": false
    },
    "look": {
      "label": "@look",
      "type": "group"
    },
    "mood": {
      "label": "@mood",
      "group": "look",
      "order": 1,
      "type": "combo",
      "options": [
        {
          "value": "dusk",
          "label": "@dusk"
        },
        {
          "value": "night",
          "label": "@night"
        }
      ],
      "default": "dusk"
    },
    "stars": {
      "label": "@stars",
      "group": "look",
      "order": 2,
      "type": "bool",
      "default": true
    },
    "sun_size": {
      "label": "@sun_size",
      "group": "look",
      "order": 5,
      "type": "slider",
      "min": 0.5,
      "max": 1.5,
      "step": 0.05,
      "default": 1.0,
      "integer": false,
      "unit": "×"
    },
    "vignette": {
      "label": "@vignette",
      "group": "look",
      "order": 6,
      "type": "bool",
      "default": true
    },
    "warmth": {
      "label": "@warmth",
      "group": "look",
      "order": 4,
      "type": "slider",
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "default": 0.35,
      "integer": false
    },
    "words": {
      "label": "@words",
      "order": 1,
      "type": "group"
    }
  },
  "presets": [
    {
      "id": "golden",
      "label": "@golden",
      "values": {
        "light": "#ffb347",
        "mood": "dusk",
        "warmth": 0.55
      }
    },
    {
      "id": "moonlight",
      "label": "@moonlight",
      "values": {
        "light": "#7f9cff",
        "mood": "night",
        "stars": true,
        "warmth": 0.2
      }
    }
  ]
}
