{
  "schema": "reiwand.wpak/2",
  "id": "io.github.reiwand.example.pond",
  "version": "1.1.0",
  "title": {
    "en": "Pond",
    "es": "Estanque"
  },
  "description": {
    "en": "Lily pads that drift aside and water that ripples where you touch or move the pointer, once you allow it, with the soft sound of water.",
    "es": "Nenúfares que se apartan y agua que se ondula donde tocas o mueves el puntero, cuando lo permites, con el suave sonido del agua."
  },
  "changes": {
    "en": "Describes itself in English and Spanish and declares its rating and the inputs it uses.",
    "es": "Se describe en inglés y en español y declara su clasificación y las entradas que usa."
  },
  "default_locale": "en",
  "authors": [
    "Reiwand contributors"
  ],
  "license": "CC0-1.0",
  "credits": [
    {
      "paths": [
        "assets/water.ogg"
      ],
      "license": "CC0-1.0",
      "attribution": "Reiwand contributors"
    }
  ],
  "origin": {
    "kind": "original"
  },
  "content": {
    "rating": "general"
  },
  "photosensitive": false,
  "kind": "scene",
  "entry": "scene.json",
  "previews": {
    "thumbnail": "preview.jpg"
  },
  "tags": [
    "example",
    "water",
    "pointer",
    "sound"
  ],
  "requires": {
    "features": [
      "effect.water_ripple.perspective",
      "effect.water_ripple.reflection",
      "effect.water_ripple.speed",
      "effect.water_ripple.tint",
      "effect.water_ripple.walls",
      "inputs.clicks",
      "inputs.pointer",
      "sound"
    ]
  },
  "inputs": [
    "pointer",
    "clicks"
  ],
  "properties": {
    "note": {
      "label": {
        "en": "Allow touch for this scene, then touch the water or move the pointer over it.",
        "es": "Permite el tacto a esta escena y toca el agua o mueve el puntero sobre ella."
      },
      "type": "label"
    },
    "pads": {
      "label": {
        "en": "Lily pads",
        "es": "Nenúfares"
      },
      "order": 2,
      "type": "bool",
      "default": true
    },
    "ripples": {
      "label": {
        "en": "Ripple strength",
        "es": "Fuerza de las ondas"
      },
      "order": 1,
      "type": "slider",
      "min": 0.0,
      "max": 96.0,
      "step": 4.0,
      "default": 40.0,
      "integer": false
    },
    "volume": {
      "label": {
        "en": "Water volume",
        "es": "Volumen del agua"
      },
      "order": 3,
      "type": "slider",
      "min": 0.0,
      "max": 100.0,
      "step": 5.0,
      "default": 100.0,
      "integer": true
    }
  }
}
