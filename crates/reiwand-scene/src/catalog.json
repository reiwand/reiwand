{
  "params": {
    "bloom": [
      { "id": "tint", "type": "color", "prefill": "#ffffff" }
    ],
    "blur": [
      { "id": "blend", "type": "blend", "prefill": "normal" },
      { "id": "amount", "type": "float", "prefill": 1, "min": 0, "max": 1 }
    ],
    "blur_motion": [
      { "id": "follow", "type": "bool", "prefill": false },
      { "id": "shutter", "type": "float", "prefill": 0.05, "min": 0, "max": 0.5 }
    ],
    "chromatic_aberration": [
      { "id": "mode", "type": "enum", "prefill": 0, "values": [
        { "value": 0, "label": { "en": "Expansion", "es": "Expansión" } }, { "value": 1, "label": { "en": "Directional", "es": "Direccional" } },
        { "value": 2, "label": { "en": "Radial", "es": "Radial" } }, { "value": 3, "label": { "en": "Barrel", "es": "Barril" } }] },
      { "id": "angle", "type": "float", "prefill": 0, "min": -360, "max": 360 }
    ],
    "depth_parallax": [
      { "id": "scale", "type": "vec2", "prefill": [1, 1], "min": -1, "max": 1 },
      { "id": "smooth", "type": "bool", "prefill": false }
    ],
    "film_grain": [
      { "id": "mono", "type": "bool", "prefill": false },
      { "id": "bias", "type": "float", "prefill": 0, "min": -1, "max": 1 },
      { "id": "blend", "type": "blend", "prefill": "overlay" }
    ],
    "flow": [
      { "id": "noise", "type": "bool", "prefill": false },
      { "id": "phase", "type": "texture", "prefill": "" }
    ],
    "god_rays": [
      { "id": "mode", "type": "enum", "prefill": 0, "values": [
        { "value": 0, "label": { "en": "Radial", "es": "Radial" } }, { "value": 1, "label": { "en": "Directional", "es": "Direccional" } },
        { "value": 2, "label": { "en": "Star", "es": "Estrella" } }] },
      { "id": "angle", "type": "float", "prefill": 90, "min": -360, "max": 360 },
      { "id": "noise", "type": "float", "prefill": 0, "min": 0, "max": 1, "uses": "time" },
      { "id": "edges", "type": "int", "prefill": 6, "min": 2, "max": 16 }
    ],
    "iris": [{ "id": "background", "type": "bool", "prefill": false }],
    "lens_distort": [{ "id": "background", "type": "bool", "prefill": false }],
    "reflection": [{ "id": "angle", "type": "float", "prefill": 0, "min": -360, "max": 360 }],
    "scroll": [
      { "id": "repeat_x", "type": "bool", "prefill": true },
      { "id": "repeat_y", "type": "bool", "prefill": true }
    ],
    "shake": [
      { "id": "noise", "type": "float", "prefill": 0, "min": 0, "max": 1 },
      { "id": "friction", "type": "float", "prefill": 0, "min": 0, "max": 1 },
      { "id": "bounds", "type": "vec2", "prefill": [1, 1], "min": 0, "max": 1 },
      { "id": "phase", "type": "texture", "prefill": "", "tool": "gray" },
      { "id": "flow", "type": "texture", "prefill": "", "tool": "flow", "paint": "#808000" },
      { "id": "motion", "type": "enum", "prefill": 0, "values": [
        { "value": 0, "label": { "en": "Noise", "es": "Ruido" } }, { "value": 1, "label": { "en": "Periodic push", "es": "Empuje periódico" } }] },
      { "id": "side", "type": "enum", "prefill": 0, "values": [
        { "value": 0, "label": { "en": "Both ways", "es": "A los dos lados" } }, { "value": 1, "label": { "en": "Forward", "es": "Hacia adelante" } },
        { "value": 2, "label": { "en": "Backward", "es": "Hacia atrás" } }] }
    ],
    "shine": [
      { "id": "blend", "type": "blend", "prefill": "add" },
      { "id": "gradient", "type": "texture", "prefill": "" },
      { "id": "style", "type": "enum", "prefill": 0, "values": [
        { "value": 0, "label": { "en": "Line", "es": "Línea" } }, { "value": 1, "label": { "en": "Double line", "es": "Línea doble" } },
        { "value": 2, "label": { "en": "Ring", "es": "Anillo" } }, { "value": 3, "label": { "en": "Glint", "es": "Destello" } }] }
    ],
    "sway": [
      { "id": "double", "type": "bool", "prefill": false },
      { "id": "phase", "type": "texture", "prefill": "" },
      { "id": "foliage", "type": "bool", "prefill": false },
      { "id": "ratio", "type": "float", "prefill": 1, "min": 0.1, "max": 10 }
    ],
    "twirl": [
      { "id": "aspect", "type": "float", "prefill": 1, "min": 0.1, "max": 10 },
      { "id": "inner", "type": "float", "prefill": 0, "min": 0, "max": 1 },
      { "id": "noise", "type": "float", "prefill": 0, "min": 0, "max": 1 },
      { "id": "repeat", "type": "bool", "prefill": false }
    ],
    "water_ripple": [
      { "id": "perspective", "type": "float", "prefill": 0, "min": 0, "max": 1 },
      { "id": "reflection", "type": "texture", "prefill": "" },
      { "id": "tint", "type": "color", "prefill": "#ffffff" },
      { "id": "walls", "type": "texture", "prefill": "" },
      { "id": "speed", "type": "float", "prefill": 1, "min": 0, "max": 4 }
    ],
    "waves": [
      { "id": "count", "type": "int", "prefill": 1, "min": 1, "max": 2 },
      { "id": "angle2", "type": "float", "prefill": 90, "min": -360, "max": 360 },
      { "id": "perspective", "type": "float", "prefill": 0, "min": 0, "max": 1 },
      { "id": "phase", "type": "texture", "prefill": "" }
    ]
  },
  "effects": []
}
