{
  "id": "reflection",
  "name": { "en": "Reflection" },
  "category": "light",
  "description": { "en": "Adds a wavy reflection below the picture.", "es": "Añade bajo la imagen un reflejo ondulado." },
  "min_fps": 30,
  "mask_mode": "strength",
  "params": [
    { "id": "line", "type": "float", "prefill": 0.6, "min": 0, "max": 1 },
    { "id": "opacity", "type": "float", "prefill": 0.6, "min": 0, "max": 1 },
    { "id": "fade", "type": "float", "prefill": 1, "min": 0, "max": 1 },
    { "id": "amplitude", "type": "float", "prefill": 2, "min": 0, "max": 128, "uses": "time" },
    { "id": "frequency", "type": "float", "prefill": 12, "min": 0, "max": 512 },
    { "id": "speed", "type": "float", "prefill": 0.5, "min": -20, "max": 20 },
    { "id": "angle", "type": "float", "unit": "degrees", "prefill": 0, "min": -360, "max": 360 }
  ],
  "passes": [{ "entry": "fs_reflection" }],
  "reach": "amplitude"
}
