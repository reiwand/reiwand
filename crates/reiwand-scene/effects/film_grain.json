{
  "id": "film_grain",
  "name": { "en": "Film grain" },
  "category": "stylize",
  "description": { "en": "Adds animated film grain.", "es": "Añade grano de película animado." },
  "mask_mode": "strength",
  "params": [
    { "id": "amount", "type": "float", "prefill": 0.05, "min": 0, "max": 1 },
    { "id": "size", "type": "float", "prefill": 1.5, "min": 0.5, "max": 16 },
    { "id": "fps", "type": "float", "prefill": 0, "min": 0, "max": 60, "uses": "time" },
    { "id": "mono", "type": "bool", "prefill": false },
    { "id": "bias", "type": "float", "prefill": 0, "min": -1, "max": 1 },
    { "id": "blend", "type": "blend", "prefill": "overlay" }
  ],
  "fuse": "color",
  "pace": { "rate": "fps" }
}
