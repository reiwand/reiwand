{
  "id": "lens_distort",
  "name": { "en": "Lens distortion" },
  "category": "distort",
  "description": { "en": "Barrel or pincushion distorts the picture like a lens.", "es": "Deforma la imagen como una lente, en barril o en cojín." },
  "mask_mode": "strength",
  "params": [
    { "id": "k1", "type": "float", "prefill": 0.1, "min": -1, "max": 1 },
    { "id": "k2", "type": "float", "prefill": 0, "min": -1, "max": 1 },
    { "id": "fit", "type": "bool", "prefill": true },
    { "id": "center", "type": "vec2", "prefill": [0.5, 0.5], "min": -1, "max": 2 },
    { "id": "background", "type": "bool", "prefill": false }
  ],
  "fuse": "uv"
}
