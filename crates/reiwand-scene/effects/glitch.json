{
  "id": "glitch",
  "name": { "en": "Glitch" },
  "category": "motion",
  "description": { "en": "Glitches the picture with shifted rows and color splits.", "es": "Estropea la imagen con filas desplazadas y colores separados." },
  "mask_mode": "strength",
  "params": [
    { "id": "bursts", "type": "float", "prefill": 0, "min": 0, "max": 10, "uses": "time" },
    { "id": "beat", "type": "bool", "prefill": false, "uses": "audio" },
    { "id": "length", "type": "float", "prefill": 0.2, "min": 0.02, "max": 2 },
    { "id": "rows", "type": "float", "prefill": 24, "min": 1, "max": 256 },
    { "id": "threshold", "type": "float", "prefill": 0.7, "min": 0, "max": 1 },
    { "id": "shift", "type": "float", "prefill": 24, "min": 0, "max": 512 },
    { "id": "split", "type": "float", "prefill": 4, "min": 0, "max": 64 },
    { "id": "jitter", "type": "float", "prefill": 2, "min": 0, "max": 64 },
    { "id": "speed", "type": "float", "prefill": 12, "min": 0, "max": 60 }
  ],
  "passes": [{ "entry": "fs_glitch" }],
  "pace": { "rate": "speed" }
}
