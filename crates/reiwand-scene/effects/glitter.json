{
  "id": "glitter",
  "name": { "en": "Glitter" },
  "category": "stylize",
  "description": { "en": "Scatters small sparkling points over the picture.", "es": "Esparce pequeños puntos brillantes sobre la imagen." },
  "mask_mode": "strength",
  "params": [
    { "id": "density", "type": "float", "prefill": 0.3, "min": 0, "max": 1 },
    { "id": "size", "type": "float", "prefill": 2, "min": 0.5, "max": 16 },
    { "id": "speed", "type": "float", "prefill": 1, "min": 0, "max": 8, "uses": "time" },
    { "id": "color", "type": "color", "prefill": "#ffffff" }
  ],
  "fuse": "color",
  "pace": { "rate": "speed" }
}
