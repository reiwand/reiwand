{
  "id": "chroma_key",
  "name": { "en": "Chroma key" },
  "category": "color",
  "description": { "en": "Removes a chosen color, making it transparent.", "es": "Quita un color elegido y lo vuelve transparente." },
  "mask_mode": "strength",
  "params": [
    { "id": "key", "type": "color", "default": "#00ff00" },
    { "id": "tolerance", "type": "float", "default": 0.1, "min": 0, "max": 1 },
    { "id": "softness", "type": "float", "default": 0.08, "min": 0, "max": 1 },
    { "id": "spill", "type": "float", "default": 0.5, "min": 0, "max": 1 },
    {
      "id": "distance",
      "type": "enum",
      "default": 0,
      "required": true,
      "values": [
        { "value": 0, "label": { "en": "Chroma only", "es": "Solo croma" } },
        { "value": 1, "label": { "en": "Full color", "es": "Color completo" } }
      ]
    },
    { "id": "keep", "type": "float", "default": 0, "min": 0, "max": 1, "required": true }
  ],
  "fuse": "color"
}
