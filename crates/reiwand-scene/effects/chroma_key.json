{
  "id": "chroma_key",
  "name": { "en": "Chroma key" },
  "category": "color",
  "description": { "en": "Removes a chosen color, making it transparent.", "es": "Quita un color elegido y lo vuelve transparente." },
  "mask_mode": "strength",
  "params": [
    { "id": "key", "type": "color", "prefill": "#00ff00" },
    { "id": "tolerance", "type": "float", "prefill": 0.1, "min": 0, "max": 1 },
    { "id": "softness", "type": "float", "prefill": 0.08, "min": 0, "max": 1 },
    { "id": "spill", "type": "float", "prefill": 0.5, "min": 0, "max": 1 },
    {
      "id": "distance",
      "type": "enum",
      "prefill": 0,
      "values": [
        { "value": 0, "label": { "en": "Chroma only", "es": "Solo croma" } },
        { "value": 1, "label": { "en": "Full color", "es": "Color completo" } }
      ]
    },
    { "id": "keep", "type": "float", "prefill": 0, "min": 0, "max": 1 }
  ],
  "fuse": "color"
}
