{
  "id": "pulse",
  "name": { "en": "Pulse" },
  "category": "color",
  "description": { "en": "Pulses brightness, color, opacity or a tinted light over time.", "es": "Hace pulsar el brillo, el color, la opacidad o una luz teñida con el tiempo." },
  "mask_mode": "strength",
  "params": [
    {
      "id": "what",
      "type": "enum",
      "prefill": 0,
      "values": [
        { "value": 0, "label": { "en": "Brightness", "es": "Brillo" } },
        { "value": 1, "label": { "en": "Color", "es": "Color" } },
        { "value": 2, "label": { "en": "Opacity", "es": "Opacidad" } },
        { "value": 3, "label": { "en": "Tinted light", "es": "Luz teñida" } }
      ]
    },
    { "id": "speed", "type": "float", "prefill": 1, "min": 0, "max": 16, "uses": "time", "yields_to": "audio_band" },
    { "id": "bounds", "type": "vec2", "prefill": [0, 1], "min": 0, "max": 4 },
    { "id": "tint_low", "type": "color", "prefill": "#000000" },
    { "id": "tint_high", "type": "color", "prefill": "#ffffff" },
    { "id": "noise", "type": "float", "prefill": 0, "min": 0, "max": 1, "uses": "time" },
    { "id": "noise_speed", "type": "float", "prefill": 1, "min": 0, "max": 16 },
    { "id": "phase", "type": "texture", "tools": ["gray"], "prefill": "" },
    { "id": "audio_band", "type": "int", "prefill": 0, "min": 0, "max": 64, "uses": "audio" }
  ],
  "passes": [{ "entry": "fs_pulse", "inputs": ["previous", "asset:phase"] }],
  "fuse": "color"
}
