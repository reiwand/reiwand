{
  "id": "light_shafts",
  "name": { "en": "Light shafts" },
  "category": "light",
  "description": { "en": "Draws soft colored light shafts across the picture.", "es": "Dibuja haces suaves de luz de color que cruzan la imagen." },
  "mask_mode": "strength",
  "params": [
    {
      "id": "direction",
      "type": "enum",
      "prefill": 0,
      "values": [
        { "value": 0, "label": { "en": "Linear", "es": "Lineal" } },
        { "value": 1, "label": { "en": "Radial", "es": "Radial" } },
        { "value": 2, "label": { "en": "Corner", "es": "Esquina" } }
      ]
    },
    { "id": "angle", "type": "float", "unit": "degrees", "prefill": 30, "min": -360, "max": 360 },
    { "id": "center", "type": "position", "prefill": [0.5, 0] },
    { "id": "color", "type": "color", "prefill": "#fff2cc" },
    { "id": "gradient", "type": "texture", "tools": ["ramp"], "prefill": "" },
    { "id": "exponent", "type": "float", "prefill": 1, "min": 0.1, "max": 8 },
    { "id": "intensity", "type": "float", "prefill": 1, "min": 0, "max": 4 },
    { "id": "feather", "type": "float", "prefill": 0.3, "min": 0, "max": 1 },
    { "id": "smoothness", "type": "float", "prefill": 0.5, "min": 0, "max": 1 },
    { "id": "speed", "type": "float", "prefill": 0.2, "min": -8, "max": 8, "uses": "time" }
  ],
  "passes": [{ "entry": "fs_light_shafts", "inputs": ["previous", "asset:gradient"] }]
}
