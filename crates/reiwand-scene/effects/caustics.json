{
  "id": "caustics",
  "name": { "en": "Caustics" },
  "category": "motion",
  "description": { "en": "Animates shifting light patterns like sunlight through water.", "es": "Anima manchas de luz cambiantes, como el sol a través del agua." },
  "min_fps": 30,
  "mask_mode": "strength",
  "params": [
    { "id": "color", "type": "color", "prefill": "#cfefff" },
    { "id": "scale", "type": "float", "prefill": 2, "min": 0.1, "max": 16 },
    { "id": "speed", "type": "float", "prefill": 0.5, "min": 0, "max": 8, "uses": "time" },
    { "id": "strength", "type": "float", "prefill": 0.6, "min": 0, "max": 4 },
    { "id": "perspective", "type": "float", "prefill": 0, "min": 0, "max": 1 }
  ],
  "fuse": "color"
}
