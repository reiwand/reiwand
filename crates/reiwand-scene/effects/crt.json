    { "id": "scan", "type": "float", "prefill": 0.3, "min": 0, "max": 1 },
    { "id": "phosphor", "type": "float", "prefill": 0.15, "min": 0, "max": 1 },
    { "id": "vignette", "type": "float", "prefill": 0.25, "min": 0, "max": 1 },
    { "id": "glow", "type": "float", "prefill": 0.15, "min": 0, "max": 1 }
  ],
  "passes": [{ "entry": "fs_crt" }],
  "quality": { "q1": { "params": { "glow": 0 } } }
