{
  "id": "crt",
  "name": { "en": "CRT screen" },
  "category": "stylize",
  "description": { "en": "Simulates an old CRT screen with scanlines and curvature.", "es": "Imita una pantalla antigua de tubo, con líneas y curvatura." },
